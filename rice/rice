compile_shaders() {  # the two deck shaders, compiled for the Qt version on this machine
  local qsb=/usr/lib/qt6/bin/qsb f
  [ -x "$qsb" ] || { log "deck: $qsb not found (package qt6-shadertools): the deck cannot draw without its compiled shaders"; return 1; }
  for f in ascii spectrum; do
    "$qsb" --glsl "300 es,150,330" -o "$R/deck/$f.frag.qsb" "$R/deck/$f.frag" 2>/dev/null || log "deck: could not compile $f.frag"
  done
}

deck_setup() {
  local name key cmd title owner
  compile_shaders
  printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Rice ASCII Deck' "Exec=$HOME/.local/bin/rice on --from=launcher" \
    'Icon=preferences-desktop-color' 'NoDisplay=true' > "$APPS/rice-deck.desktop"       # gives the deck window its name and icon
  while IFS=: read -r name key cmd title <&3; do          # 1. the launcher files
    [ -n "$name" ] || continue
    printf '%s\n' '[Desktop Entry]' 'Type=Application' "Name=$title" "Exec=/usr/bin/python3 $R/deck/ctl.py $cmd" \
      'Icon=preferences-desktop-color' 'NoDisplay=true' 'X-KDE-GlobalAccel-CommandShortcut=true' > "$APPS/$name.desktop"
  done 3<<< "$DECK_KEYS"
  kbuildsycoca6 >/dev/null 2>&1 || true                   # 2. let KDE see them before registering keys
  while IFS=: read -r name key cmd title <&3; do          # 3. the keys, each only if free or already ours
    [ -n "$name" ] || continue
    owner=$(gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
        --method org.kde.KGlobalAccel.actionList "([$key,0,0,0],)" 2>/dev/null </dev/null)
    case "$owner" in
      *"@as []"*|*"$name.desktop"*)
        gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
          --method org.kde.KGlobalAccel.doRegister "['$name.desktop', '_launch', '$title', '$title']" >/dev/null </dev/null
        gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
          --method org.kde.KGlobalAccel.setShortcut "['$name.desktop', '_launch', '$title', '$title']" "[$key]" 6 >/dev/null </dev/null ;;
      *) log "deck: the key for '$title' is taken ($owner): not set" ;;
    esac
  done 3<<< "$DECK_KEYS"
  kbuildsycoca6 >/dev/null 2>&1 || true
  log "deck: shortcuts set (Meta+Alt+PgUp/PgDn volume, Meta+Alt+, / . previous/next)"
}

deck_uninstall() {
  local name key cmd title
  while IFS=: read -r name key cmd title <&3; do
    [ -n "$name" ] || continue
    gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
      --method org.kde.KGlobalAccel.unregister "$name.desktop" "_launch" >/dev/null 2>&1 </dev/null
    kwriteconfig6 --file kglobalshortcutsrc --group "services" --group "$name.desktop" --key _launch --delete
    [ -f "$C/kglobalshortcutsrc" ] && sed -i "/^\\[services\\]\\[$name\\.desktop\\]\$/,/^\$/d" "$C/kglobalshortcutsrc"
    rm -f "${APPS:?}/${name:?}.desktop"
  done 3<<< "$DECK_KEYS"
  rm -f "${APPS:?}/rice-deck.desktop"
  rm -rf "${RUNDIR:?}"
}

rice_uninstall() {
  only_installed uninstall
  rice_off
  deck_uninstall
  for a in on off; do
    gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
      --method org.kde.KGlobalAccel.unregister "rice-$a.desktop" "_launch" >/dev/null 2>&1
    kwriteconfig6 --file kglobalshortcutsrc --group "services" --group "rice-$a.desktop" --key _launch --delete
    rm -f "$APPS/rice-$a.desktop"
  done
  [ -f "$C/kglobalshortcutsrc" ] && sed -i '/^\[services\]\[rice-\(on\|off\)\.desktop\]$/,/^$/d' "$C/kglobalshortcutsrc"
  button_remove                                           # panel button, then the launchers
  rm -f "$APPS/rice-toggle.desktop" "$APPS/rice-flavour.desktop" "$HOME/Desktop/rice-toggle.desktop"
  kbuildsycoca6 >/dev/null 2>&1 || true
  rm -f "$SLICE_FILE"; systemctl --user daemon-reload
  rm -f "$HOME/.local/bin/rice"
  rm -rf "$HOME/.local/share/fonts/rice" && fc-cache -f >/dev/null 2>&1
  rm -rf "$ST" "$INSTALLED" "$RCACHE" "$RCFG"
  echo "[rice] uninstalled. Kept: the packages, and anything in ~/Music."
}

case "${1:-status}" in
  on) rice_on ;;
  off) rice_off ;;
  player) rice_player "${2:-}" ;;
  layout) rice_layout "${2:-}" ;;
  flavour|flavor) rice_flavour "${2:-}" ;;
  toggle) if is_on; then log "toggle: rice is on -> off"; rice_off; else log "toggle: rice is off -> on"; rice_on; fi ;;
  status) rice_status ;;
  setup) rice_setup ;;
  button) rice_button ;;
  button-remove) button_remove ;;            # internal: remove only the panel button
  deck-setup) only_installed deck-setup; deck_setup ;;   # internal: compile shaders + global shortcuts only
  uninstall) rice_uninstall ;;
  *) echo "usage: rice on|off|toggle|status|flavour NAME|random|list|player pear|fooyin|auto|layout deck|classic|setup|button|uninstall"; exit 2 ;;
esac
