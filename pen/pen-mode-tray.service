[Unit]
Description=Pen mode tray icon (DRAW / NAVIGATE switch for touch-only styluses)
PartOf=graphical-session.target
After=plasma-plasmashell.service

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/pen-mode/pen-mode-tray.py
Restart=on-failure
RestartSec=5
MemoryMax=200M
CPUQuota=20%

[Install]
WantedBy=graphical-session.target
